{
  "Item": {
    "description": "system.description",
    "descriptionPublic": "system.description.public",
    "descriptionPrivate": "system.description.private",
    "requirements": "system.requirements",
    "actions": {
      "path": "system.actions",
      "converter": "structured",
      "cardinality": "many",
      "keys": ["name"],
      "mapping": {
        "name": "name",
        "description": "description",
        "condition": "condition"
      }
    }
  },
  "Actor": {
    "tokenName": "prototypeToken.name",
    "ancestry": {
      "path": "system.details.ancestry",
      "converter": "crucibleEmbeddedDetail",
      "packId": "crucible.ancestry"
    },
    "background": {
      "path": "system.details.background",
      "converter": "crucibleEmbeddedDetail",
      "packId": "crucible.background"
    },
    "archetype": {
      "path": "system.details.archetype",
      "converter": "crucibleEmbeddedDetail",
      "packId": "crucible.archetype"
    },
    "taxonomy": {
      "path": "system.details.taxonomy",
      "converter": "crucibleEmbeddedDetail",
      "packId": "crucible.taxonomy"
    },
    "biographyPublic": "system.details.biography.public",
    "biographyPrivate": "system.details.biography.private",
    "items": {
      "path": "items",
      "converter": "document",
      "documentType": "Item",
      "cardinality": "many",
      "fallbackPolicy": "owner-package-first"
    }
  }
}
