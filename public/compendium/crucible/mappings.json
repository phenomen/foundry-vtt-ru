{
  "Item": {
    "description": "system.description",
    "descriptionPublic": "system.description.public",
    "descriptionPrivate": "system.description.private",
    "requirements": "system.requirements",
    "actions": {
      "path": "system.actions",
      "converter": "structured",
      "cardinality": "many",
      "keys": ["name", "id"],
      "mapping": {
        "name": "name",
        "description": "description",
        "condition": "condition"
      }
    },
    "_identity": {
      "export": ["crucibleOriginalName", "_id", "id"]
    }
  },
  "Actor": {
    "description": {
      "path": "system.details.biography",
      "converter": "crucibleOmit"
    },
    "tokenName": {
      "path": "prototypeToken.name",
      "converter": "crucibleOmit"
    },
    "items": {
      "path": "items",
      "converter": "document",
      "documentType": "Item",
      "cardinality": "many",
      "fallbackPolicy": "owner-package-first"
    },
    "_identity": {
      "export": ["crucibleOriginalName", "_id", "id"]
    }
  },
  "ActiveEffect": {
    "_identity": {
      "export": ["crucibleOriginalName", "_id", "id"]
    },
    "changes": {
      "path": "system.changes",
      "converter": "structured",
      "cardinality": "many",
      "keys": ["key"],
      "valuePath": "value"
    }
  },
  "JournalEntry": {
    "_identity": {
      "export": ["crucibleOriginalName", "_id", "id"]
    },
    "categories": {
      "path": "categories",
      "converter": "crucibleNames"
    }
  },
  "JournalEntryPage": {
    "_identity": {
      "export": ["crucibleOriginalName", "_id", "id"]
    }
  },
  "Scene": {
    "_identity": {
      "export": ["crucibleOriginalName", "_id", "id"]
    }
  },
  "Adventure": {
    "folders": {
      "path": "folders",
      "converter": "crucibleNames"
    }
  }
}
